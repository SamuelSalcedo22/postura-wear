# Copia este archivo como `.env` y completa los valores. `.env` nunca se sube a git.
# En Cloud Run estas variables se definen en el servicio, no en un archivo.
# La autenticación usa la cuenta de servicio de Cloud Run (o `gcloud auth
# application-default login` en local): no se necesitan claves JSON.

# Proyecto y región de Google Cloud.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Modelo de Gemini en Vertex AI para consejos y resúmenes.
# Si queda vacío, el backend responde con textos de respaldo.
GEMINI_MODEL=

# (Opcional) Endpoint de Vertex AI con el clasificador desplegado por ml/deploy_vertex.py.
# Si queda vacío, se usa el modelo local o las reglas.
VERTEX_ENDPOINT_ID=

# (Opcional) Ruta del modelo local. Por defecto: backend/model/posture.joblib
MODEL_PATH=

# --- Solo para ml/deploy_vertex.py ---
# Bucket de Cloud Storage para los artefactos, por ejemplo gs://mi-bucket/postura
VERTEX_STAGING_BUCKET=
# Imagen de predicción de scikit-learn publicada por Vertex AI (ver su documentación).
VERTEX_SERVING_IMAGE=
